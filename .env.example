# 飞书应用凭证（团队共享）
FEISHU_APP_ID=""
FEISHU_APP_SECRET=""

# 你的飞书 Open ID（必填，采集本人的消息）
# 获取：飞书搜"飞书小助手"发送 /myopenid
FEISHU_OPEN_ID=""

# 飞书周报表 ID（在周报页面 URL 中 ruleId= 后面的数字）
FEISHU_REPORT_RULE_ID="7179489743821406210"

# 飞书智能伙伴 Aily 应用 ID（用于 AI 自动生成周报，可选）
# 不配置时使用 LLM API 或关键词兜底
# FEISHU_AILY_APP_ID=""

# LLM API 配置（Aily 不可用时降级使用，可选）
# 兼容 OpenAI API 格式的任何服务：DeepSeek、OpenRouter、硅基流动等
# LLM_API_KEY="sk-xxx"
# LLM_API_BASE="https://api.openai.com/v1"     # DeepSeek: https://api.deepseek.com/v1
# LLM_MODEL="gpt-4o-mini"                       # DeepSeek: deepseek-chat

# ==================== 用户授权配置 ====================
# 为了采集所有群的消息（不限于机器人所在群），需要配置用户授权：
#
# 1. 在飞书开放平台 > 你的应用 > 安全设置 中添加重定向 URL：
#    http://127.0.0.1:18765
#
# 2. 确保应用已开通以下权限并发布：
#    - im:message:readonly（读取消息）
#    - contact:user.base:readonly（读取用户信息）
#    - calendar:calendar:readonly（日历，可选）
#    - task:task:readonly（任务，可选）
#    - docs:doc:readonly（文档，可选）
#
# 3. 运行授权：
#    npm run oauth
#
# 4. 授权后 Token 自动保存到 .feishu-user-token.json
# ========================================================
